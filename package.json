{
  "name": "intelligent-document-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:chunking": "node --experimental-strip-types --test tests/chunking.test.mjs",
    "sample:pdf": "node scripts/generate-sample-pdf.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.10",
    "next": "16.4.6",
    "pdfjs-dist": "6.5.438",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "typescript": "5.9.3"
  }
}
