generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DocumentStatus {
  PROCESSED
  FAILED
}

// Sprint 6: every document belongs to one user. Credentials are stored only as
// an Argon2id hash. Auth.js uses JWT sessions, so no Session/Account tables are
// needed; the signed cookie is the session mechanism.
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  documents    Document[]
}

model Document {
  id               String         @id @default(cuid())
  userId           String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  pageCount        Int
  status           DocumentStatus @default(PROCESSED)
  errorMessage     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages            DocumentPage[]

  @@index([createdAt])
  @@index([userId, createdAt])
}

// Persistent fixed-window rate limiting. The key is an opaque hash of the
// subject (user id, email or IP); the row survives process restarts and is
// shared by every replica using the same database.
model RateLimitBucket {
  key             String   @id
  count           Int      @default(0)
  windowStartedAt DateTime
  expiresAt       DateTime

  @@index([expiresAt])
}

model DocumentPage {
  id         String          @id @default(cuid())
  documentId String
  pageNumber Int
  text       String
  document   Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunks     DocumentChunk[]

  @@unique([documentId, pageNumber])
  @@index([documentId])
}

// Sprint 5 adds a full-text GIN expression index in the migration
// 20261112220247_add_document_chunk_fts_index. Prisma cannot declare
// expression indexes here; review future migrations so it is not dropped.
model DocumentChunk {
  id             String          @id @default(cuid())
  documentPageId String
  chunkIndex     Int
  content        String
  startChar      Int
  endChar        Int
  createdAt      DateTime        @default(now())
  documentPage   DocumentPage    @relation(fields: [documentPageId], references: [id], onDelete: Cascade)
  embeddings     ChunkEmbedding[]

  @@unique([documentPageId, chunkIndex])
  @@index([documentPageId])
}

model ChunkEmbedding {
  id            String        @id @default(cuid())
  chunkId       String
  modelId       String
  modelRevision String
  dimensions    Int
  // pgvector's vector type is not a Prisma scalar. Prisma exposes this column
  // as Unsupported, so all vector reads/writes use parameterized raw SQL.
  embedding     Unsupported("vector(384)")
  createdAt     DateTime      @default(now())
  chunk         DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@unique([chunkId, modelId, modelRevision])
  @@index([modelId, modelRevision])
}
