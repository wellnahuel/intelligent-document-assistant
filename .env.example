# Copy this file to .env for local development.
# In Vercel, set the same names per environment (Development, Preview,
# Production). Never commit real values and never prefix a private value with
# NEXT_PUBLIC_: Next.js would include it in the client bundle.
#
# Local, Preview and Production must use different databases and different
# secrets. A Preview branch must never point at the Production database.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Runtime connection used by the application (src/lib/db.ts).
# Local Docker Compose maps PostgreSQL to host port 5434.
DATABASE_URL="postgresql://ida:ida@localhost:5434/ida?schema=public"

# Optional. Used only by the Prisma CLI (migrations/introspection) when the
# provider gives a pooled runtime URL and a direct URL for migrations, for
# example Neon. The runtime keeps using DATABASE_URL.
# DIRECT_URL=""

# Optional pg pool bound per process. Vercel defaults to 1; elsewhere to 5.
# Range: 1-20.
# DATABASE_POOL_MAX="1"

# ---------------------------------------------------------------------------
# Auth.js (Sprint 6)
# ---------------------------------------------------------------------------
# Signs/encrypts the session cookie. Generate with: openssl rand -base64 32
# Never expose it with NEXT_PUBLIC_ and never commit the real value.
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Per-user usage limits (Sprint 6)
# Positive integers. Rate-limit rows live in PostgreSQL, so they are shared
# across processes/replicas using this database.
# ---------------------------------------------------------------------------
MAX_DOCUMENTS_PER_USER="20"
UPLOAD_RATE_LIMIT_PER_HOUR="10"
EMBEDDING_RATE_LIMIT_PER_HOUR="10"
ASK_RATE_LIMIT_PER_HOUR="30"
SEARCH_RATE_LIMIT_PER_HOUR="60"
LOGIN_RATE_LIMIT_PER_15_MIN="10"
LOGIN_IP_RATE_LIMIT_PER_15_MIN="30"
REGISTER_RATE_LIMIT_PER_HOUR="5"
REGISTER_EMAIL_RATE_LIMIT_PER_HOUR="3"

# ---------------------------------------------------------------------------
# Upload limits
# ---------------------------------------------------------------------------
# Local default: 10 MB. On Vercel the app defaults to 4 MB and clamps larger
# values, because a Vercel Function request body is capped at 4.5 MB.
MAX_PDF_SIZE_MB="10"
MAX_PDF_PAGES="50"

# ---------------------------------------------------------------------------
# Chunking
# ---------------------------------------------------------------------------
# Positive integers; overlap must be smaller than target.
CHUNK_TARGET_CHARS="1200"
CHUNK_OVERLAP_CHARS="150"
CHUNK_MIN_CHARS="100"

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# EMBEDDING_PROVIDER:
#   local       Transformers.js in this process (development default).
#   openrouter  Remote OpenRouter embeddings (recommended for Vercel).
# Both document and query embeddings always use this same configuration.
EMBEDDING_PROVIDER="local"

# Local mode: Hugging Face model. The first run downloads the pinned revision
# into the cache directory. The SQL column is fixed at vector(384).
# Remote mode: required. Must be an OpenRouter embeddings model id that can
# return 384 dimensions, for example openai/text-embedding-3-small.
EMBEDDING_MODEL_ID="Xenova/multilingual-e5-small"

# Local mode: pinned Hugging Face commit.
# Remote mode: an operator-managed label stored with each embedding. OpenRouter
# does not expose immutable model snapshots; bump this label if the upstream
# model changes and regenerate the embeddings.
EMBEDDING_MODEL_REVISION="761b726dd34fb83930e26aab4e9ac3899aa1fa78"

# Local mode only.
EMBEDDING_CACHE_DIR=".cache/transformers"
EMBEDDING_BATCH_SIZE="4"

# Remote mode only. Request timeout in milliseconds (1000-120000).
OPENROUTER_EMBEDDING_TIMEOUT_MS="20000"

# ---------------------------------------------------------------------------
# Diagnostic vector search
# ---------------------------------------------------------------------------
SEARCH_DEFAULT_TOP_K="5"
SEARCH_MAX_TOP_K="20"
SEARCH_QUERY_MAX_CHARS="1000"

# ---------------------------------------------------------------------------
# Generative answers (server only)
# ---------------------------------------------------------------------------
# OPENROUTER_API_KEY is secret: do not expose it with NEXT_PUBLIC_ and do not
# commit it. In remote-embedding mode it is also required for embeddings.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=8000
RAG_QUESTION_MAX_CHARS=1000
RAG_PROVIDER_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Retrieval evaluation (Sprint 5)
# ---------------------------------------------------------------------------
# EVAL_TOP_K is the metrics cutoff; RETRIEVAL_CANDIDATES is how many hits each
# source returns before RRF fusion; RETRIEVAL_RRF_K is the RRF constant.
EVAL_TOP_K=5
RETRIEVAL_CANDIDATES=20
RETRIEVAL_RRF_K=60

# ---------------------------------------------------------------------------
# Optional reranking (server only)
# ---------------------------------------------------------------------------
# Leave RERANK_MODEL empty to disable it. RERANK_API_KEY is optional and falls
# back to OPENROUTER_API_KEY. Enabling reranking sends the question and
# candidate chunks to OpenRouter; use only fictional or shareable documents.
RERANK_MODEL=
RERANK_API_KEY=
RERANK_TOP_N=5
RERANK_TIMEOUT_MS=20000
