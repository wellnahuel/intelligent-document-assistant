# Local development only. Never commit real credentials.
DATABASE_URL="postgresql://ida:ida@localhost:5434/ida?schema=public"

# Upload limits. Values are parsed as positive integers.
MAX_PDF_SIZE_MB="10"
MAX_PDF_PAGES="50"

# Chunking parameters. Positive integers; overlap must be smaller than target.
CHUNK_TARGET_CHARS="1200"
CHUNK_OVERLAP_CHARS="150"
CHUNK_MIN_CHARS="100"

# Local embeddings. The first run downloads the pinned model revision into the
# cache directory. The vector dimension is fixed at 384 by the SQL column.
EMBEDDING_MODEL_ID="Xenova/multilingual-e5-small"
EMBEDDING_MODEL_REVISION="761b726dd34fb83930e26aab4e9ac3899aa1fa78"
EMBEDDING_CACHE_DIR=".cache/transformers"
EMBEDDING_BATCH_SIZE="4"

# Diagnostic vector search.
SEARCH_DEFAULT_TOP_K="5"
SEARCH_MAX_TOP_K="20"
SEARCH_QUERY_MAX_CHARS="1000"

# Generative answers (server only).
# OPENROUTER_API_KEY is secret: do not expose it with NEXT_PUBLIC_ and do not commit it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=8000
RAG_QUESTION_MAX_CHARS=1000
RAG_PROVIDER_TIMEOUT_MS=30000
